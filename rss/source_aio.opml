      <outline text="Beetle PCE PS5" title="Beetle PCE PS5" type="rss" xmlUrl="https://github.com/MisterTemaki/beetlepcePS5" description="Beetle PCE (PC Engine, TurboGrafx-16, SuperGrafx, PC Engine CD) as a native PS5 app."/>
      <outline text="Stella PS5" title="Stella PS5" type="rss" xmlUrl="https://github.com/MisterTemaki/stellaPS5" description="Port of Stella (Atari 2600), Atari 5200, 7800 and Lynx as a native PS5 app."/>
      <outline text="Forwarder Manager" title="Forwarder Manager" type="rss" xmlUrl="https://github.com/heydemoura/ps5-forwarder-manager" description="Create and edit home-screen forwarders that launch emulators and other apps with custom art, music and arguments."/>
      <outline text="Arcade Gallery" title="Arcade Gallery" type="rss" xmlUrl="https://github.com/zomavich-netizen/Arcade-PS5" description="Native PS5 arcade emulator with per-game save states, controller navigation, detailed game information, and automatic screen orientation. No games or BIOS files are included."/>
      <outline text="YouTube Max’d" title="YouTube Max’d" type="rss" xmlUrl="https://github.com/HandshakeHackin/youtube-maxd" description="Standalone PS5 YouTube client based on ProsperoTube, with local voice search, Smart playlists, adaptive quality and red/white DualSense effects."/>
      <outline text="Pulse" title="Pulse" type="rss" xmlUrl="https://github.com/shwan-ps5/pulse" description="A Beat Saber-style rhythm game for PS VR2 and Sense controllers that turns any MP3 into note maps on the console."/>
      <outline text="Prospero Win" title="Prospero Win" type="rss" xmlUrl="https://github.com/mpereiraesaa/prospero-win" description="Windows compatibility runtime for native PlayStation 5 homebrew."/>
      <outline text="Nuvio Pro" title="Nuvio Pro" type="rss" xmlUrl="https://github.com/speed-y/nuvio-pro-ps5" description="Nuvio Pro is a controller-first streaming app for jailbroken PS5s, with EVO Player playback, PS5 keyboard search, profiles and resume support. The console hosts its own UI. Tested on firmware 12.70."/>
      <outline text="Nuvio PS5" title="Nuvio PS5" type="rss" xmlUrl="https://github.com/bilawalriaz/nuvio-ps5-homebrew" description="Nuvio TV for a jailbroken PS5, with EVO native playback and the interface served by the console itself."/>
