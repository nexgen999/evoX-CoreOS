      <outline text="Spot5" title="Spot5" type="rss" xmlUrl="https://github.com/abhi245y/spot5" description="Unofficial native Spotify player, not affiliated with Spotify: Home, Your Library, playlists, artists, Now Playing and more, with Spotify Connect. Needs Premium."/>
      <outline text="ORION Media Center" title="ORION Media Center" type="rss" xmlUrl="https://github.com/XeN-Made/Orion-Media-Center" description="A launcher that shows your PS5 and PS4 games, homebrew, media apps and emulated games in one library, with box art, tabs, themes and autoboot."/>
