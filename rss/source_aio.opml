      <outline text="wiliwili" title="wiliwili" type="rss" xmlUrl="https://github.com/carlchina/wiliwili" description="Bilibili client for PS5 with 1080P/4K playback, danmaku and DLNA casting."/>
      <outline text="Codex PS5 - Prototype" title="Codex PS5 - Prototype" type="rss" xmlUrl="https://github.com/Portablelle/Codex-PS5" description="Native PS5 assistant with controller input, local voice transcription and console tools; requires a separate service payload."/>
      <outline text="Prospero Explorer" title="Prospero Explorer" type="rss" xmlUrl="https://github.com/SvenGDK/Prospero-Explorer" description="File explorer for PS5 that manages files and archives, plays media, edits text, installs packages and serves files over the network."/>
      <outline text="Prospero Multi Tools" title="Prospero Multi Tools" type="rss" xmlUrl="https://github.com/SvenGDK/Prospero-Multi-Tools" description="Backup manager for PS5: browse and edit PS1 to PS5, PSP and PS Vita backups, install packages and launch PS1/PS2/PSP titles. Needs the unjail payload."/>
