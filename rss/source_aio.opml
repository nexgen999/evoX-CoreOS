    <outline text="ProsperoStore" title="ProsperoStore">
      <outline text="Cyberworld Endless" title="Cyberworld Endless" type="rss" xmlUrl="https://github.com/saschb2b/Mega-Man-Battle-Network-Cyberworld-Endless" description="A roguelike built on the real Mega Man Battle Network 6, from your own ROM: every run jacks MegaMan into a newly generated net of battles, loot and guardian Navis."/>
      <outline text="Playden" title="Playden" type="rss" xmlUrl="https://github.com/leolobato/playden-ps5" description="Plays your Steam games on the PS5: sign in to Steam, download your Windows games and run each one through Wine as its own title."/>
      <outline text="OliSe Player" title="OliSe Player" type="rss" xmlUrl="https://github.com/Marice/OliSePlayer" description="Tracker music radio in FastTracker II style, streaming MOD, XM, S3M and IT from The Mod Archive."/>
      <outline text="PS64" title="PS64" type="rss" xmlUrl="https://github.com/dantaipan/PS64" description="Play the Commodore 64 on PS5: stream and control a C64 Ultimate, or use the built-in VICE emulator, with Assembly64 search."/>
      <outline text="PC5" title="PC5" type="rss" xmlUrl="https://github.com/bornaradusin/PC5" description="Launcher for your own PC games via Wine, DXVK and VKD3D-Proton: console or USB installs, Steam emulator, covers, DualSense, up to four players, web page, crash reports and updates."/>
      <outline text="Home5" title="Home5" type="rss" xmlUrl="https://github.com/bornaradusin/Home5" description="Home Assistant on the PS5: your own rooms of lights, blinds, thermostats, scenes and sensors, with the DualSense. L2/R2 dim lights and the light bar follows them."/>
      <outline text="SymphonyStation5" title="SymphonyStation5" type="rss" xmlUrl="https://github.com/TsvetomirGT/SymphonyStation5" description="A native Navidrome music client for the PlayStation 5."/>
      <outline text="XashPS5" title="XashPS5" type="rss" xmlUrl="https://github.com/GordonProsperoMan/xash3d-ps5" description="Native PS5 port of Xash3D FWGS: Half-Life, Opposing Force and Blue Shift up to 4K at 60 FPS with DualSense input. Needs your own Half-Life game data."/>
      <outline text="Source Port" title="Source Port" type="rss" xmlUrl="https://github.com/gmorb/source-port-ps5" description="Native PS5 port of the Source engine that runs Half-Life 2 from your own steam_legacy game files, with sound and DualSense controls."/>
      <outline text="Middle Ages Ping Pong" title="Middle Ages Ping Pong" type="rss" xmlUrl="https://github.com/STL1te/MedievalTennis" description="Classic ping pong in a medieval setting: play against the computer or a friend on the same console."/>
      <outline text="VITA5" title="VITA5" type="rss" xmlUrl="https://github.com/StonedModder/VITA5" description="Play a PS Vita on the PS5 over one USB cable."/>
      <outline text="Syobon Action" title="Syobon Action" type="rss" xmlUrl="https://github.com/kvaps/syobon-action-ps5" description="Native PS5 port of Syobon Action (Cat Mario), the deliberately unfair platformer by Chiku, with DualSense controls, a pause menu and a stage select."/>
      <outline text="Afterglow" title="Afterglow" type="rss" xmlUrl="https://github.com/DevvNirvana/afterglow" description="Internet radio with 220+ stations and 56 full-screen music visualizer scenes."/>
      <outline text="ProsperoSunshine" title="ProsperoSunshine" type="rss" xmlUrl="https://github.com/Darkatek7/ProsperoSunshine" description="Sunshine-compatible game-stream host: play your PS5 on any Moonlight client in your LAN, with picture, game audio and controller input. Tested on firmware 13.00; other versions untested."/>
      <outline text="SudokuZen" title="SudokuZen" type="rss" xmlUrl="https://github.com/Bruce303lee/sudokuzen" description="A quiet 9x9 Sudoku game for PS5 with six themes, a color-tile mode, animated backdrops, an undo stack, and a demo mode that narrates each solving technique."/>
      <outline text="PS5X360" title="PS5X360" type="rss" xmlUrl="https://github.com/BrinooTk/PS5X360" description="Experimental Xbox 360 emulator for PlayStation 5, built on Xenia Canary with native audio, DualSense input and RADV Vulkan graphics."/>
      <outline text="ccleste" title="ccleste" type="rss" xmlUrl="https://github.com/darkxex/PS5_Celeste" description="This is a C source port of the original celeste (Celeste classic) for the PICO-8, designed to be portable. Now you can enjoy the port on your PS5."/>
      <outline text="Mediathek" title="Mediathek" type="rss" xmlUrl="https://github.com/M0S4YSH3LL0/mediathek-ps5" description="A Netflix-style movie library for your PS5"/>
      <outline text="PayLoader" title="PayLoader" type="rss" xmlUrl="https://github.com/Marice/ps5-payloader" description="A controller front-end for Payload Manager (pldmgr), which it brings: start, install and update payloads, edit your boot chain with a USB safety net, and install the Signal suite."/>
      <outline text="Ruffle Flash" title="Ruffle Flash" type="rss" xmlUrl="https://github.com/ZiZc3/Ruffle-Flash-PS5" description="PS5 Port of Ruffle Flash Emulator."/>
      <outline text="ScreenTester5" title="ScreenTester5" type="rss" xmlUrl="https://github.com/Marice/ScreenTester5" description="Screen tester: solid colours and test patterns to find dead or stuck pixels, check uniformity and geometry, and run stuck-pixel recovery."/>
      <outline text="SuperTuxKart" title="SuperTuxKart" type="rss" xmlUrl="https://github.com/Marice/stk-ps5" description="Alpha port of the open-source kart racer SuperTuxKart 1.5, with story mode and local races; network play is switched off."/>
      <outline text="Rush 2 Recompiled" title="Rush 2 Recompiled" type="rss" xmlUrl="https://github.com/Marice/rush2-ps5" description="Native PS5 port of Rush 2 Recompiled, the N64 racer recompiled with 4K output and 60 fps; needs your own Rush 2: Extreme Racing USA (USA) ROM."/>
      <outline text="Wave Race 64 Recompiled" title="Wave Race 64 Recompiled" type="rss" xmlUrl="https://github.com/Marice/wave-race-64-ps5" description="Native PS5 port of Wave Race 64: Recompiled, the N64 jet ski racer recompiled with 4K output, 60 fps and a modern water renderer; needs your own Wave Race 64 (USA) (Rev A) ROM."/>
      <outline text="Signal Companion" title="Signal Companion" type="rss" xmlUrl="https://github.com/Marice/ps5-signal-companion" description="Set your PS5's light colour and ps5-signal's startup tune, and manage the suite: start, update and autoload ps5-signal, ps5-exporter and ps5-homeassistant, and link the PS5 to Home Assistant."/>
      <outline text="A2 Racer II" title="A2 Racer II" type="rss" xmlUrl="https://github.com/Marice/a2-racer-2-ps5" description="Native PS5 port of A2 Racer II (Davilex, 1998) on berobloom's a2racer2-re, with DualSense, touchpad mouse and a police light bar; needs your own disc image."/>
      <outline text="JSRF Unleashed" title="JSRF Unleashed" type="rss" xmlUrl="https://github.com/Marice/jsrf-ps5" description="Native PS5 port of JuMatt's JSRF Unleashed, Jet Set Radio Future recompiled, with a Vulkan renderer at up to 4K; needs your own Jet Set Radio Future (USA) disc image."/>
      <outline text="Pixel Museum" title="Pixel Museum" type="rss" xmlUrl="https://github.com/LoZazaMastro/Pixel-Museum" description="An interactive museum of video game history and culture, with illustrated stories, soundtracks, collectible pins, playable experiences and creative workshops."/>
      <outline text="Stremio Plus" title="Stremio Plus" type="rss" xmlUrl="https://github.com/LoZazaMastro/Stremio-Plus" description="Unofficial native Stremio client for PS5 with Prospero UI, add-on sync, torrent streaming, offline downloads, enhanced playback stability and sortable high-resolution download artwork."/>
      <outline text="The Simpsons Game" title="The Simpsons Game" type="rss" xmlUrl="https://github.com/LoZazaMastro/TheSimpsonsGame-PS5-Builder" description="Create a PS5-ready The Simpsons Game folder from your Xbox 360 game files, with graphics settings and optional frame generation."/>
      <outline text="Jewel Case" title="Jewel Case" type="rss" xmlUrl="https://github.com/SkaRift/JewelCase" description="Home-screen ROM launcher that shows every system's games as cartridges and discs with box art and starts each in the right emulator."/>
      <outline text="RommPS" title="RommPS" type="rss" xmlUrl="https://github.com/s0liton/RommPS" description="Syncs your emulator saves and states with a RomM server and downloads games from your RomM library."/>
      <outline text="PSteroid5" title="PSteroid5" type="rss" xmlUrl="https://github.com/futurepr0n/PSteroid5" description="Vector Asteroids with online high scores, co-op rooms, a shared MMO world with browser players, a public ship hangar and a controller ship editor."/>
      <outline text="Stremio" title="Stremio" type="rss" xmlUrl="https://github.com/Sp9nky/unofficial-stremio-ps5-port" description="Unofficial Stremio client for the PS5"/>
      <outline text="VLC" title="VLC" type="rss" xmlUrl="https://github.com/ZiZc3/VLC" description="VLC media player for PS5: videos, music, photos, subtitles, DVD images and more"/>
      <outline text="Prospero Themes" title="Prospero Themes" type="rss" xmlUrl="https://github.com/Darkatek7/ProsperoThemes" description="Theme manager for the PS5 home screen: download community themes, preview and apply .p5theme packs, import them from USB and restore the originals."/>
      <outline text="Breath of the Wild" title="Breath of the Wild" type="rss" xmlUrl="https://github.com/bizkut/SavageWindRecomp" description="Native PS5 port of the Savage Wind recompilation with frame generation, FSR 3.1 and HDR. Requires your own game files and keys."/>
      <outline text="SpeedBreaker" title="SpeedBreaker" type="rss" xmlUrl="https://github.com/bystritskiy/speedbreaker-ps5" description="Need for Speed: Most Wanted (2005), the Xbox 360 version statically recompiled to run natively on PS5, in 4K at up to 60 fps (bring your own USA disc)."/>
      <outline text="Capy Mobile" title="Capy Mobile" type="rss" xmlUrl="https://github.com/khalifa007/CapyMobile" description="Java phone games (J2ME) on the PS5: a native homebrew emulator app"/>
      <outline text="Breeze" title="Breeze" type="rss" xmlUrl="https://github.com/MiladRTX/Breeze" description="Custom fan curve for the PS5: choose how fast the fan runs at each temperature, with live readings, 24-hour history and presets."/>
      <outline text="Raptor: Call of the Shadows (PS5)" title="Raptor: Call of the Shadows (PS5)" type="rss" xmlUrl="https://github.com/ChaDea1/RaptorPS5" description="Unofficial native PS5 port of Raptor: Call of the Shadows with DualSense controls and optional first-launch shareware download."/>
      <outline text="Bedlam 2: Absolute Bedlam (PS5)" title="Bedlam 2: Absolute Bedlam (PS5)" type="rss" xmlUrl="https://github.com/ChaDea1/Bedlam2-PS5" description="Native PS5 port; user supplies game files in /data/Bedlam2PS5/content; saves and generated files persist in /data/Bedlam2PS5/saves."/>
      <outline text="Chiral-FTP" title="Chiral-FTP" type="rss" xmlUrl="https://github.com/Herbrax/Chiral-FTP" description="File manager, FTP server, FTP/SFTP client and browser web app for the PS5, with Quick connect to chiral-ftp on your Switch, Mac, Windows or Linux."/>
      <outline text="XPSemu" title="XPSemu" type="rss" xmlUrl="https://github.com/ZiZc3/XPSemu" description="Original Xbox emulator for PS5, based on xemu."/>
      <outline text="PSXS5" title="PSXS5" type="rss" xmlUrl="https://github.com/SynoPiia/PSXS5" description="PSXS5 (PlayStation X Super 5): a PlayStation 1 emulator running natively on jailbroken PS5, based on PCSX-ReARMed. Cover-flow shelf, xBR upscaling, RetroAchievements, cheats."/>
