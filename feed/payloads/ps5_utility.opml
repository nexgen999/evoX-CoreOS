<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>ps5_utility</title>
  </head>
  <body>
    <outline text="ChronicLoader-PS5-Payload" title="ChronicLoader-PS5-Payload" type="rss" xmlUrl="https://github.com/StonedModder/ChronicLoader-PS5-Payload" author="StonedModder" description="ChronicLoader utility payload for PS5."/>
    <outline text="PS Game State Lib" title="PS Game State Lib" type="rss" xmlUrl="https://github.com/StonedModder/ps-game-state-lib" author="StonedModder" description="Standalone PS5 game-state detection payload - webui ps5ip:9877 ."/>
    <outline text="PS-DiscordPresence" title="PS-DiscordPresence" type="rss" xmlUrl="https://github.com/StonedModder/PS-DiscordPresence" author="StonedModder" description="PS5 game activity service with a local status endpoint and a Python Discord RPC bridge."/>
    <outline text="unrar-ps5" title="unrar-ps5" type="rss" xmlUrl="https://github.com/bizkut/unrar-ps5" author="bizkut" description="PS5 ELF payload for extracting RAR and 7z archives on a jailbroken PS5 and installing extracted apps into a configurable layout.."/>
    <outline text="PS5-Power-Payloads-Project" title="PS5-Power-Payloads-Project" type="rss" xmlUrl="https://github.com/MasterPS0/PS5-Power-Payloads-Project" author="MasterPS0" description="PS5-Power-Payloads-Project utility."/>
    <outline text="ps5-date-time-sync" title="ps5-date-time-sync" type="rss" xmlUrl="https://github.com/kerrdec97/ps5-date-time-sync" author="kerrdec97" description="A lightweight, standalone PS5 payload that restores the console's system date and time using public NTP servers."/>
    <outline text="FGG-Unpack" title="FGG-Unpack" type="rss" xmlUrl="https://github.com/FGGstore/FGG-Unpack" author="FGGstore" description="Extract .zip and .7z archives directly on a jailbroken PlayStation 5."/>
    <outline text="ytps5" title="ytps5" type="rss" xmlUrl="https://github.com/MasterShivnath007/ytps5-sponsorblock" author="MasterShivnath007" description="Filters YouTube ads and skips sponsor segments in the official PS5 video app at runtime. One ELF, native settings panel, no app packages or DRM tools."/>
  </body>
</opml>
